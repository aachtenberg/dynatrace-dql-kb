# Copy to .env and fill in. The .env file is gitignored — never commit real tokens.

# Dynatrace tenant URL. Must be the platform host, no path, no trailing slash.
#   https://<env-id>.apps.dynatrace.com
# The classic https://<env-id>.live.dynatrace.com host has no Grail query API.
DT_ENVIRONMENT_URL=https://YOUR_ENV.apps.dynatrace.com

# Token created in that same environment. Platform tokens (dt0s16) are sent as
# Bearer. Classic tokens (dt0c01) are sent as Api-Token.
# Scopes: storage:metrics:read, storage:entities:read, storage:logs:read,
#   storage:events:read, storage:bizevents:read, storage:spans:read,
#   storage:buckets:read
DT_API_TOKEN=dt0s16.XXXXXXXX

# Corporate proxy and TLS inspection. The scripts use the standard library,
# which reads these from the environment. Uncomment to set them from this file.
# HTTPS_PROXY=http://proxy.company.com:8080
# SSL_CERT_FILE=/path/to/company-ca.pem

# Set to 1 to write a placeholder host (instead of your real tenant URL) into
# the generated docs — use when committing the generated docs to a shared repo.
# DT_REDACT_TENANT=1

# ----- util/dql_agent.sh: a Bedrock model that writes and runs DQL. -----
# No pip install. AWS credentials come from AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN, ~/.aws/credentials, or
# `aws configure export-credentials` (SSO). ./util/dql_agent.sh --check tests them.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_REGION=us-east-1
# DQL_AGENT_SCAN_LIMIT_GB=50

# ----- Optional generation. Leave unset and the IDE model writes the DQL. -----
# Two outside setups show up in a locked-down network:
#
# Amazon Bedrock, Converse API. boto3 uses the normal AWS credential chain.
# LLM_PROVIDER=bedrock
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#
# Private OpenAI-compatible server. Ollama, vLLM, and most other inference
# servers all speak POST /v1/chat/completions, so one client covers them.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_CTX=16384
# Why this model, and how to re-run the comparison: evaluations/ollama-dql.md
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=your-served-model-name
# LLM_PROVIDER=openai_compatible
# PRIVATE_BASE_URL=http://inference.internal:8080
# PRIVATE_MODEL=your-model-name
# PRIVATE_API_KEY=          # only if that server requires a bearer token
