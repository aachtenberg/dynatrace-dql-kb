# Copy to .env and fill in. The .env file is gitignored — never commit real tokens.

# Dynatrace tenant URL. Must be the platform host, no path, no trailing slash.
#   https://<env-id>.apps.dynatrace.com
# The classic https://<env-id>.live.dynatrace.com host has no Grail query API.
DT_ENVIRONMENT_URL=https://YOUR_ENV.apps.dynatrace.com

# Token created in that same environment. Platform tokens (dt0s16) are sent as
# Bearer. Classic tokens (dt0c01) are sent as Api-Token.
# Scopes: storage:metrics:read, storage:entities:read, storage:logs:read,
#   storage:events:read, storage:bizevents:read, storage:spans:read,
#   storage:buckets:read
DT_API_TOKEN=dt0s16.XXXXXXXX

# Corporate proxy and TLS inspection. The scripts use the standard library,
# which reads these from the environment. Uncomment to set them from this file.
# HTTPS_PROXY=http://proxy.company.com:8080
# SSL_CERT_FILE=/path/to/company-ca.pem

# Set to 1 to write a placeholder host (instead of your real tenant URL) into
# the generated docs — use when committing the generated docs to a shared repo.
# DT_REDACT_TENANT=1

# ----- A model for util/dql_chat.sh and util/dql_agent.sh -----
# Set up one (or more). ./util/dql_agent.sh --check tests each one it finds.
# The chat offers all of them; LLM_PROVIDER picks the default (Bedrock if unset).

# A) Amazon Bedrock. Credentials: ~/.aws/credentials (AWS_PROFILE), SSO,
#    AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or the task/pod/instance role.
#    Default model: Claude Sonnet 5. Not enabled on your account? Pick one from
#    ./util/dql_agent.sh --models and set it here.
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# B) Azure AI Foundry. Setup, step by step: util/dql_chat.md, "Azure AI Foundry".
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_KEY=

# C) Ollama. One on this machine is found on its own.
#    Why this model: evaluations/ollama-dql.md
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://192.168.0.10:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_CTX=16384

# Others (vllm, openai_compatible, openai, anthropic): util/dql_chat.md, "Model providers".

# ----- Optional -----
# DQL_AGENT_SCAN_LIMIT_GB=50
# Browser chat; the defaults suit a desktop. See util/dql_chat.md.
# DQL_CHAT_PORT=8750
# DQL_CHAT_HISTORY=0                  # keep chats in memory only (default: SQLite file)
# DQL_CHAT_DB=~/.local/share/dql-chat/chats.db
# DQL_CHAT_PROVIDERS=auto             # or a fixed list, e.g. bedrock,ollama
# DQL_CHAT_PROBLEMS=0                 # no open-problems check on the welcome screen
# DQL_CHAT_AUTH=token
# DQL_CHAT_ALLOWED_MODELS=us.anthropic.claude-sonnet-*
